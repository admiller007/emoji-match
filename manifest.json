{
  "manifest_version": 3,
  "name": "Emojimatch",
  "version": "1.1.0",
  "description": "Find the right emoji or GIF for your message, picked by an AI model of your choice through OpenRouter.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Emojimatch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "Open Emojimatch"
    }
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://openrouter.ai/*", "https://api.klipy.com/*", "https://api.giphy.com/*"]
}
